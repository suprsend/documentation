# Copy to .docs-agent/local/.env (gitignored) and fill in. Leave a line empty to skip that source.
# Value can be @path/to/file to read the value from a file (handy for the browser login state).

# Slack (xoxb- bot tokens from api.slack.com/apps → your app → OAuth & Permissions)
SLACK_INTERNAL_BOT_TOKEN=
SLACK_COMMUNITY_BOT_TOKEN=

# Staging SuprSend workspace (SETUP.md step 3)
SUPRSEND_STAGING_WORKSPACE_KEY=
SUPRSEND_STAGING_WORKSPACE_SECRET=
SUPRSEND_STAGING_API_KEY=
SUPRSEND_STAGING_SERVICE_TOKEN=

# Browser login for dashboard flows: the base64 value from install/dashboard-login.sh,
# or @~/docs-agent-state.b64 if you saved it to a file
DASHBOARD_STORAGE_STATE=

# Postman (da postman)
POSTMAN_API_KEY=

# Support email (optional)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Optional: pin a model for the agents; blank = Claude Code's default
DOCS_AGENT_MODEL=
