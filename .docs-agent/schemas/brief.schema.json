{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Docs brief (planner \u2192 executor handoff)",
  "type": "object",
  "required": [
    "briefs",
    "skipped"
  ],
  "properties": {
    "briefs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "change_type",
          "summary",
          "sources",
          "pages",
          "facts",
          "use_case",
          "test_plan",
          "confidence"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "Imperative, <80 chars. 'Document idempotency_key on Node SDK trigger()'"
          },
          "change_type": {
            "enum": [
              "new_feature",
              "behavior_change",
              "breaking_change",
              "deprecation",
              "clarification",
              "docs_bug",
              "new_example"
            ]
          },
          "doc_category": {
            "enum": [
              "changelog",
              "sdk_reference",
              "clarification",
              "concept",
              "implementation_guide",
              "api_reference",
              "quickstart",
              "ai_integration",
              "screenshot_refresh"
            ],
            "description": "Primary category, used for autonomy graduation stats"
          },
          "summary": {
            "type": "string",
            "description": "2-4 sentences: what changed and why a reader cares"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "source_id",
                "url"
              ],
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              }
            }
          },
          "pages": {
            "type": "array",
            "description": "Every page to touch. Existing pages by repo path; new pages with proposed path.",
            "items": {
              "type": "object",
              "required": [
                "path",
                "action",
                "what"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "action": {
                  "enum": [
                    "update",
                    "create",
                    "deprecate",
                    "nav_only"
                  ]
                },
                "doc_type": {
                  "enum": [
                    "api_reference",
                    "sdk",
                    "cli",
                    "mcp",
                    "schema",
                    "concept",
                    "guide",
                    "quickstart",
                    "ai_integration",
                    "faq",
                    "changelog"
                  ],
                  "description": "Picks the executor's writing lane"
                },
                "what": {
                  "type": "string",
                  "description": "Exact edits: sections, params, examples"
                }
              }
            }
          },
          "facts": {
            "type": "array",
            "description": "Verified facts the executor may state. Each cites where it was verified.",
            "items": {
              "type": "object",
              "required": [
                "fact",
                "evidence"
              ],
              "properties": {
                "fact": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string",
                  "description": "file:line, commit sha, or thread quote"
                }
              }
            }
          },
          "use_case": {
            "type": "object",
            "required": [
              "persona",
              "scenario"
            ],
            "properties": {
              "persona": {
                "type": "string",
                "description": "From context/customers.md, e.g. 'B2B SaaS, multi-tenant'"
              },
              "scenario": {
                "type": "string",
                "description": "The concrete example to use in the doc"
              },
              "from_real_signal": {
                "type": "boolean",
                "description": "true if taken (anonymised) from a Slack/support thread"
              }
            }
          },
          "test_plan": {
            "type": "array",
            "description": "What the reviewer must run against staging. Empty only for pure prose changes.",
            "items": {
              "type": "string"
            }
          },
          "open_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ask": {
            "type": "string",
            "description": "Slack handle or GitHub user who can answer open_questions"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "changelog": {
            "type": "boolean",
            "description": "Also add a changelog entry"
          },
          "postman": {
            "type": "boolean",
            "description": "The Postman collection needs a matching update (new/changed endpoint, field or example)"
          },
          "ui_flows": {
            "type": "array",
            "description": "Dashboard procedures to capture (screenshots) and verify in a real browser",
            "items": {
              "type": "object",
              "required": [
                "name",
                "page",
                "goal"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "flow id, e.g. workflows/add-batch-node"
                },
                "page": {
                  "type": "string",
                  "description": "docs page the flow backs up"
                },
                "goal": {
                  "type": "string",
                  "description": "what the user achieves, in one line"
                },
                "start": {
                  "type": "string",
                  "description": "dashboard path to start from, if known"
                },
                "screenshots": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "moments worth a screenshot, e.g. 'Batch node settings panel'"
                }
              }
            }
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "description": "Signals with no doc impact, and why. Kept so humans can audit the planner.",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "reason"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "merged_into_existing": {
      "type": "array",
      "description": "Signals that belong to an already-open brief issue.",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "issue"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "issue": {
            "type": "integer"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}